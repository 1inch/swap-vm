{
  "name": "@1inch/swap-vm",
  "version": "1.2.0-rc.1",
  "description": "Swap Virtual Machine protocol to build token swap strategies with programmable instruction sequences",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "files": [
    "contracts",
    "LICENSES",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@1inch/aqua": "1.0.2-rc.2",
    "@1inch/solidity-utils": "7.0.3",
    "@openzeppelin/contracts": "5.6.1",
    "forge-std": "github:foundry-rs/forge-std#v1.11.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.2.0",
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-keystore": "3.1.1",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.0",
    "@nomicfoundation/hardhat-verify": "3.1.2",
    "hardhat": "3.18.1",
    "hardhat-ignore-warnings": "0.3.0"
  },
  "resolutions": {
    "elliptic": "6.6.1"
  },
  "scripts": {
    "clean": "npx hardhat clean",
    "test": "npx hardhat test --build-profile fast",
    "test:solidity": "npx hardhat test solidity --build-profile fast",
    "test:typescript": "npx hardhat test nodejs",
    "test:coverage": "npx hardhat test --coverage",
    "build": "npx hardhat compile",
    "build:fast": "npx hardhat compile --build-profile fast",
    "build:production": "npx hardhat compile --build-profile production",
    "snapshot": "npx hardhat clean && npx hardhat test solidity --snapshot ./test/solidity/gas/*",
    "snapshot:check": "npx hardhat clean && npx hardhat test solidity --snapshot-check ./test/solidity/gas/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1inch/swap-vm.git"
  },
  "author": "Degensoft Ltd.",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/1inch/swap-vm/issues"
  },
  "homepage": "https://github.com/1inch/swap-vm"
}
